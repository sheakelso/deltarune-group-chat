{
	"name": "deltarune-group-chat",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"server": "tsx server.ts",
		"addsprites": "tsx add-sprites.ts",
		"dev": "vite dev --host",
		"devhost": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview  --host",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-node-polyfills": "^0.28.0"
	},
	"dependencies": {
		"@mikro-orm/core": "^7.1.7",
		"@mikro-orm/mariadb": "^7.1.7",
		"@types/bcrypt": "^6.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/nodemailer": "^8.0.1",
		"axios": "^1.18.1",
		"bcrypt": "^6.0.0",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"mariadb": "^3.5.3",
		"nodemailer": "^9.0.3",
		"socket.io": "^4.8.3",
		"socket.io-client": "^4.8.3",
		"uuid": "^14.0.1"
	},
	"allowScripts": {
		"bcrypt@6.0.0": true,
		"esbuild@0.28.1": true
	}
}
